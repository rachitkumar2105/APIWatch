# Copy to .env and adjust for your environment. Never commit a real .env file.

# SQLAlchemy connection string. Default is a local SQLite file.
# Verified working against Postgres too — e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/apiwatch
DATABASE_URL=sqlite:///./apiwatch.db

# Secret used to sign JWT access tokens. MUST be set to a real random value
# outside local dev — the app logs a startup warning if left at its default.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# How long an access token stays valid before the client must log in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# Grafana admin password, used by docker-compose.yml. Change this before
# running the observability stack anywhere reachable by anyone else.
GRAFANA_ADMIN_PASSWORD=admin

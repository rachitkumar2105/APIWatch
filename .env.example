# Copy to .env for local runs. Never commit a real .env file.
# On Hugging Face Spaces, set these under Settings > Variables and secrets instead.

# "production" makes the API refuse to start without a real JWT secret and
# hides /metrics unless METRICS_TOKEN is set. The Docker image defaults to it.
APP_ENV=development

# SQLAlchemy connection string. Default is a local SQLite file.
# For data that survives restarts on a hosted deployment, use Postgres, e.g. Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# (postgres:// URLs are accepted too and rewritten automatically.)
DATABASE_URL=sqlite:///./apiwatch.db

# Secret used to sign JWT access tokens. At least 32 characters in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# How long an access token stays valid before the client must log in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of browser origins allowed to call the API (no trailing slash).
# Local frontend: python -m http.server 4173 --directory frontend
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000

# Optional regex for origins you can't list up front, e.g. Vercel preview deployments.
# CORS_ORIGIN_REGEX=^https://apiwatch-[a-z0-9-]+\.vercel\.app$

# Optional bearer token required to scrape /metrics. Leave empty locally.
# METRICS_TOKEN=

# "true" only behind a reverse proxy (Hugging Face Spaces, a load balancer), so the
# rate limiter keys on the real client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Grafana admin password, used by docker-compose.yml. Change this before
# running the observability stack anywhere reachable by anyone else.
GRAFANA_ADMIN_PASSWORD=admin
